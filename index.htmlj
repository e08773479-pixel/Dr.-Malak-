<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الدكتورة ملك | Study Dashboard</title>

  <link rel="stylesheet" href="css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="stars"></div>

  <!-- القائمة الجانبية -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-icon">🎓</div>
      <span>الدكتورة ملك</span>
    </div>

    <nav class="menu">
      <button class="nav-item active" data-section="home"><span>⌂</span> الرئيسية</button>
      <button class="nav-item" data-section="sessions"><span>♡</span> جلسات المذاكرة</button>
      <button class="nav-item" data-section="stats"><span>▥</span> إحصائيات</button>
      <button class="nav-item" data-section="tasks"><span>✓</span> مهام اليوم</button>
      <button class="nav-item" data-section="notes"><span>▤</span> الملاحظات</button>
      <button class="nav-item" data-section="prayer"><span>☪</span> الأذان الهادئ</button>
    </nav>

    <div class="sidebar-quote">
      <p>لا تتوقف عندما تتعب</p>
      <p>توقف عندما تنتهي</p>
      <div>♥</div>
    </div>

    <button class="settings-btn" id="settingsBtn">⚙ الإعدادات</button>
  </aside>

  <!-- المحتوى الرئيسي -->
  <main class="main-content">

    <!-- الهيدر -->
    <header class="topbar">
      <div class="title-area">
        <h1 id="pageTitle">الدكتورة ملك <span>♛</span></h1>
        <p id="pageSubTitle">رحلتك نحو التفوق تبدأ من هنا ✨</p>
      </div>

      <div class="top-actions">
        <button class="icon-btn" id="notificationBtn">🔔</button>
        <div class="profile">
          <div class="profile-crown">♛</div>
          <span>ملك</span>
          <span class="arrow">⌄</span>
        </div>
      </div>
    </header>

    <!-- 1. الرئيسية -->
    <section id="home" class="page-section active">
      <div class="dashboard-grid">
        <div class="left-column">

          <!-- المؤقت -->
          <section class="timer-card glass-card">
            <div class="timer-background"></div>
            <div class="timer-header">
              <h2>🧠 جلسة مذاكرة مركزة</h2>
            </div>

            <div class="timer-circle">
              <svg class="progress-ring" width="280" height="280">
                <circle class="progress-bg" cx="140" cy="140" r="118"/>
                <circle class="progress-bar" id="progressBar" cx="140" cy="140" r="118"/>
              </svg>
              <div class="timer-content">
                <div id="timerDisplay">45:00</div>
                <span>دقيقة</span>
              </div>
            </div>

            <div class="session-label" id="sessionName">جلسة تركيز</div>

            <div class="timer-controls">
              <button class="control-btn" id="resetBtn">↻</button>
              <button class="play-btn" id="startBtn">▶</button>
              <button class="control-btn" id="stopBtn">■</button>
            </div>

            <div class="timer-modes">
              <button class="mode-btn active" data-time="2700" data-name="جلسة تركيز">
                🧠 <span>جلسة تركيز</span> <small>45 دقيقة</small>
              </button>
              <button class="mode-btn" data-time="300" data-name="استراحة قصيرة">
                ☕ <span>استراحة قصيرة</span> <small>5 دقائق</small>
              </button>
              <button class="mode-btn" data-time="900" data-name="استراحة طويلة">
                ☕ <span>استراحة طويلة</span> <small>15 دقيقة</small>
              </button>
            </div>
          </section>

          <!-- رسالة تحفيزية مميزة -->
          <section class="motivation-card">
            <div class="motivation-decoration">♡</div>
            <div class="motivation-content">
              <div class="small-hearts">♡ ✦ I LOVE YOU ✦ ♡</div>
              <h2>I Love You <span>Dr. Malak</span> ❤️</h2>
              <p>يارب ملك تجيب 100%، لأنك قدها وقادرة تحققي كل اللي بتحلمي بيه ✨</p>
              <div class="heart-line">─────── ♡ ───────</div>
            </div>
          </section>
        </div>

        <div class="right-column">
          <!-- ملخص جلسات اليوم -->
          <section class="today-sessions glass-card">
            <div class="section-title">
              <h2>جلسات اليوم</h2>
              <button class="new-session-btn" id="quickNewSessionBtn">+ جديدة</button>
            </div>
            <div class="sessions-list" id="homeSessionsList"></div>
            <div class="today-total">
              <span>◷ إجمالي الوقت المحفوظ</span>
              <strong id="homeTotalStudyTime">0 دقيقة</strong>
            </div>
          </section>
        </div>
      </div>
    </section>

    <!-- 2. قسم جلسات المذاكرة -->
    <section id="sessions" class="page-section" style="display: none;">
      <section class="today-sessions glass-card">
        <div class="section-title">
          <h2>جدول الجلسات والدروس</h2>
          <button class="new-session-btn" id="openModalBtn">+ إضافة مادة / درس</button>
        </div>
        <div class="sessions-list" id="fullSessionsList"></div>
      </section>
    </section>

    <!-- 3. قسم الإحصائيات -->
    <section id="stats" class="page-section" style="display: none;">
      <section class="stats-card glass-card">
        <div class="section-title">
          <h2>إحصائياتك 📈</h2>
        </div>
        <div class="stats-content">
          <div class="stat-box">
            <span>إجمالي وقت الدراسة</span>
            <strong id="totalStudyTime">0 دقيقة</strong>
          </div>
          <div class="stat-box">
            <span>عدد الجلسات المضافة</span>
            <strong id="sessionsCount">0</strong>
          </div>
          <div class="stat-box">
            <span>المهام المنجزة</span>
            <strong id="completedTasksStats">0</strong>
          </div>
        </div>
      </section>
    </section>

    <!-- 4. قسم المهام -->
    <section id="tasks" class="page-section" style="display: none;">
      <section class="tasks-card glass-card">
        <div class="section-title">
          <h2>مهام اليوم ✓</h2>
        </div>
        <div id="tasksList"></div>
        <div class="add-task">
          <input type="text" id="taskInput" placeholder="أضيفي مهمة جديدة..." />
          <button id="addTaskBtn">+</button>
        </div>
      </section>
    </section>

    <!-- 5. قسم الملاحظات -->
    <section id="notes" class="page-section" style="display: none;">
      <section class="notes-section glass-card">
        <div class="section-title">
          <h2>📝 ملاحظاتي</h2>
        </div>
        <textarea id="notesArea" placeholder="اكتبي كل أفكارك وملاحظاتك هنا يا دكتورة ملك..."></textarea>
        <div class="notes-footer">
          <span id="saveStatus">يتم الحفظ تلقائياً</span>
          <button id="clearNotesBtn">مسح الملاحظات</button>
        </div>
      </section>
    </section>

    <!-- 6. قسم مواقيت الصلاة -->
    <section id="prayer" class="page-section" style="display: none;">
      <section class="prayer-card">
        <div class="prayer-bg"></div>
        <div class="prayer-header">
          <h2>🌙 مواقيت الصلاة والأذان</h2>
        </div>

        <div class="prayer-info">
          <span id="nextPrayerName">جاري تحديد الموقع والمواقيت...</span>
          <strong id="nextPrayerTime">--:--</strong>
          <small id="prayerCountdown"></small>
        </div>

        <div class="prayer-controls" style="margin-top: 15px;">
          <button id="enableAudioBtn">🔔 تفعيل صوت الأذان تلقائياً</button>
        </div>

        <div class="prayer-times-mini" id="prayerTimesGrid" style="margin-top: 20px;">
          <span>الفجر <b id="fajrTime">--:--</b></span>
          <span>الظهر <b id="dhuhrTime">--:--</b></span>
          <span>العصر <b id="asrTime">--:--</b></span>
          <span>المغرب <b id="maghribTime">--:--</b></span>
          <span>العشاء <b id="ishaTime">--:--</b></span>
        </div>
      </section>
    </section>

    <footer class="footer-quote">
      ✨ استمرّي اليوم، فخورة بيكي الآن وغداً ستكوني فخورة بنفسك أكثر ❤️ ✨
    </footer>
  </main>

  <!-- نافذة إضافة جلسة -->
  <div class="modal" id="sessionModal">
    <div class="modal-content">
      <button class="close-modal" id="closeModal">×</button>
      <h2>إضافة جلسة جديدة ✨</h2>
      <input type="text" id="subjectInput" placeholder="اسم المادة (فيزياء، كيمياء...)" />
      <input type="time" id="sessionTimeInput" />
      <button id="saveSessionBtn">حفظ الجلسة</button>
    </div>
  </div>

  <!-- صوت الأذان (رابط مباشر) -->
  <audio id="adhanAudio" preload="auto">
    <source src="https://cdn.islamicfinder.org/adhan/makkah.mp3" type="audio/mpeg">
  </audio>

  <!-- الملفات البرمجية -->
  <script src="js/app.js"></script>
  <script src="js/timer.js"></script>
  <script src="js/tasks.js"></script>
  <script src="js/notes.js"></script>
  <script src="js/sessions.js"></script>
  <script src="js/prayer.js"></script>
</body>
</html>
